# Contact form (src/app/api/contact/route.ts). Copy to .env.local and fill in.
RESEND_API_KEY=
# Where messages arrive. With the default onboarding@resend.dev sender, Resend only
# delivers to the email of the Resend account owner until you verify a domain.
CONTACT_EMAIL=

# Cloudflare Turnstile (anti-bot). Create a widget at dash.cloudflare.com > Turnstile.
# Site key is public (used in the browser); secret key is server-only.
# If TURNSTILE_SECRET_KEY is empty the check is skipped (local dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
